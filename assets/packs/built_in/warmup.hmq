{
  "id": "warmup_001",
  "name": "Разминка",
  "author": "Команда Как слышно?",
  "description": "Лёгкие вопросы для начала игры",
  "version": "1.0",
  "easy": [
    {"id": "e1", "text": "Напишите на карточке слово 'напишите'", "answer": "напишите"},
    {"id": "e2", "text": "Самый большой океан на Земле", "answer": "Тихий океан"},
    {"id": "e3", "text": "Как зовут друга Винни Пуха?", "answer": "Кристофер Робин"},
    {"id": "e4", "text": "Что означает фразеологизм 'бить баклуши'?", "answer": "Бездельничать"}
  ],
  "medium": [
    {"id": "m1", "text": "Тридцать три корабля лавировали, лавировали, да не ...", "answer": "вылавировали"},
    {"id": "m2", "text": "Кто написал 'Скотный двор'?", "answer": "Джордж Оруэлл"},
    {"id": "m3", "text": "Что может одновременно идти, стоять, висеть и лежать?", "answer": "Часы"},
    {"id": "m4", "text": "Группа Волковой и Катиной", "answer": "Тату"}
  ],
  "hard": [
    {"id": "h1", "text": "Что такое титикака?", "answer": "Озеро"},
    {"id": "h2", "text": "Главная героиня обрамления сказочного цикла '1000 и 1 ночь'", "answer": "Шахерезада"},
    {"id": "h3", "text": "Как называется ощущение, когда реальность повторяется?", "answer": "Дежавю"},
    {"id": "h4", "text": "Полное безветрие на море", "answer": "Штиль"}
  ]
}